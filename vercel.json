{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:id((?!admin|quienes-somos|equipo-editorial|contacto|tarifas-publicitarias|auspiciar-boletin|alianzas-donaciones|articulo|api|content|images|.*\\.).*)",
      "destination": "/articulo.html?id=:id"
    }
  ]
}
